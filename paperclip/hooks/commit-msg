#!/usr/bin/env bash
# Keystone agents' commits must carry the team-rule trailers in the final trailer block, where
# git and review digests can read them.
set -euo pipefail

trailers="$(git interpret-trailers --parse "$1")"
subject="$(grep -v '^#' "$1" | head -n1)"

reject() {
    echo "commit-msg: $1" >&2
    echo "Put the trailers together in the last paragraph of the message, with no blank line between them." >&2
    exit 1
}

grep -q '^Co-Authored-By: ' <<<"$trailers" || reject "missing 'Co-Authored-By: <your name> <marioppavlov@gmail.com>' trailer."
if [[ "$subject" == "fix(review):"* ]]; then
    grep -q '^Review-Finding: ' <<<"$trailers" || reject "fix(review) commit is missing its 'Review-Finding: <finding id> (<role>)' trailer."
fi
