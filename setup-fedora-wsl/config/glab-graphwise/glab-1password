#!/usr/bin/python3
import json
import os
from pathlib import Path
import subprocess
import sys

config_root = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
config_path = config_root / 'glab-1password/graphwise.json'
try:
    config = json.loads(config_path.read_text())
except (OSError, ValueError):
    sys.exit(f'Create a valid Graphwise profile at {config_path}.')
if not isinstance(config, dict) or any(
    not isinstance(config.get(key), str) or not config[key].strip()
    for key in ('op_executable', 'secret_reference', 'host')
):
    sys.exit('The Graphwise profile requires op_executable, secret_reference, and host.')
if not config['secret_reference'].startswith('op://'):
    sys.exit('secret_reference must be a 1Password op:// reference, not a token.')

glab = str(Path.home() / '.local/share/mise/shims/glab')
if not os.access(glab, os.X_OK):
    sys.exit('Install glab through mise before using the Graphwise profile.')
try:
    result = subprocess.run(
        [config['op_executable'], 'read', '--no-newline', config['secret_reference']],
        capture_output=True,
    )
except OSError:
    sys.exit('Cannot start the 1Password CLI configured in the Graphwise profile.')
if result.returncode:
    sys.exit('1Password could not retrieve the Graphwise token. Check Windows authorization and vault access.')
try:
    token = result.stdout.decode('utf-8').rstrip('\r\n')
except UnicodeDecodeError:
    sys.exit('The 1Password field is not a valid UTF-8 token.')
if not token:
    sys.exit('The 1Password Graphwise token field is empty.')
environment = os.environ.copy()
environment['GITLAB_TOKEN'] = token
environment['GITLAB_HOST'] = config['host']
os.execve(glab, [glab, *sys.argv[1:]], environment)
