#!/usr/bin/python3
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def load_profile(path):
    try:
        config = json.loads(path.read_text())
    except (OSError, ValueError):
        sys.exit(f'Create a valid 1Password profile at {path}.')
    if not isinstance(config, dict):
        sys.exit(f'Expected a JSON object in {path}.')
    return config


config_root = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
profile_dir = config_root / 'glab-1password'
glab = str(Path.home() / '.local/share/mise/shims/glab')
arguments = sys.argv[1:]
profile = 'graphwise'
if arguments[:1] == ['--auto']:
    profile = None
    arguments.pop(0)
if arguments[:1] == ['--graphwise']:
    profile = 'graphwise'
    arguments.pop(0)
elif arguments[:1] == ['--profile']:
    if len(arguments) < 2:
        sys.exit('--profile requires a profile name.')
    profile = arguments[1]
    arguments = arguments[2:]

if not os.access(glab, os.X_OK):
    sys.exit('Install glab through mise before using the 1Password wrapper.')

explicit_target = any(
    arg in ('--repo', '-R', '--hostname')
    or arg.startswith(('--repo=', '-R', '--hostname='))
    for arg in arguments
)
if profile is None and not explicit_target:
    current = Path.cwd().resolve()
    matches = {}
    for path in sorted(profile_dir.glob('*.json')):
        config = load_profile(path)
        roots = config.get('paths', [])
        if not isinstance(roots, list) or any(not isinstance(root, str) for root in roots):
            sys.exit(f'paths must be a list of directory names in {path}.')
        for root in roots:
            directory = Path(root).expanduser()
            if not directory.is_absolute():
                sys.exit(f'Use absolute or ~/ paths in {path}.')
            directory = directory.resolve()
            if current == directory or directory in current.parents:
                matches[path.stem] = max(matches.get(path.stem, 0), len(directory.parts))
    if matches:
        best = max(matches.values())
        candidates = [name for name, depth in matches.items() if depth == best]
        if len(candidates) != 1:
            sys.exit('Multiple profiles match this directory; select one with --profile NAME.')
        profile = candidates[0]

if profile is None:
    os.execv(glab, [glab, *arguments])
if not re.fullmatch(r'[A-Za-z0-9_-]+', profile):
    sys.exit('Profile names may contain only letters, numbers, underscores, and hyphens.')
config = load_profile(profile_dir / f'{profile}.json')
if any(
    not isinstance(config.get(key), str) or not config[key].strip()
    for key in ('op_executable', 'secret_reference', 'host')
):
    sys.exit('The profile requires op_executable, secret_reference, and host.')
if not config['secret_reference'].startswith('op://'):
    sys.exit('secret_reference must be a 1Password op:// reference, not a token.')

try:
    result = subprocess.run(
        [config['op_executable'], 'read', '--no-newline', config['secret_reference']],
        capture_output=True,
    )
except OSError:
    sys.exit('Cannot start the 1Password CLI configured in the profile.')
if result.returncode:
    sys.exit('1Password could not retrieve the token. Check Windows authorization and vault access.')
try:
    token = result.stdout.decode('utf-8').rstrip('\r\n')
except UnicodeDecodeError:
    sys.exit('The 1Password field is not a valid UTF-8 token.')
if not token:
    sys.exit('The 1Password token field is empty.')
environment = os.environ.copy()
environment['GITLAB_TOKEN'] = token
environment['GITLAB_HOST'] = config['host']
os.execve(glab, [glab, *arguments], environment)
